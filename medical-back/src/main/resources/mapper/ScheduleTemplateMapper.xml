<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.edu.ncu.medical.mapper.ScheduleTemplateMapper">

    <resultMap id="BaseResultMap" type="cn.edu.ncu.medical.entity.ScheduleTemplate">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="doctorId" column="doctor_id" jdbcType="BIGINT"/>
        <result property="weekDay" column="week_day" jdbcType="INTEGER"/>
        <result property="morningLimit" column="morning_limit" jdbcType="INTEGER"/>
        <result property="afternoonLimit" column="afternoon_limit" jdbcType="INTEGER"/>
        <result property="isActive" column="is_active" jdbcType="INTEGER"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="isDeleted" column="is_deleted" jdbcType="INTEGER"/>
    </resultMap>

    <select id="findByWeekDay" resultType="cn.edu.ncu.medical.entity.ScheduleTemplate">
        SELECT *
        FROM schedule_template
        WHERE week_day = #{weekDay}
          AND is_deleted = 0
          AND is_active = 1
    </select>

</mapper>
